 * Migración única e idempotente (V2) del Consolidado 2026 hacia la hoja ACTIVIDADES activa.
 * Numera actividades repetidas (1, 2, 3...) y evita falsos positivos por subcadenas.
 */
function sigcEjecutarMigracionConsolidado2026_() {
  const props = PropertiesService.getScriptProperties();
  if (props.getProperty('MIGRACION_CONSOLIDADO_2026_V2_OK') === 'true') return false;

  const lock = LockService.getScriptLock();
  if (!lock.tryLock(15000)) return false;
