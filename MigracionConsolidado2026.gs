      item.ID_ACTIVIDAD = 'CAP-2026-' + String(maxNum).padStart(3, '0');
      existentes[nNom] = true;

      const fila = new Array(tabla.encabezados.length).fill('');
      Object.keys(item).forEach(function(k) {
        const kNorm = normalizarEncabezado_(k);
        if (idxMapa[kNorm] !== undefined) fila[idxMapa[kNorm]] = item[k];
      });
      nuevasFilas.push(fila);
    });

    if (nuevasFilas.length > 0) {
      hoja.getRange(hoja.getLastRow() + 1, 1, nuevasFilas.length, tabla.encabezados.length).setValues(nuevasFilas);
      cambios += nuevasFilas.length;
    }

    if (cambios > 0) {
      sigcInvalidarCacheTabla_(WEBAPP_CONFIG.HOJAS.ACTIVIDADES);
      try { sigcRegistrarLog('IMPORTAR', 'ACTIVIDADES', 'CONSOLIDADO-2026-V2', 'Actualizadas/migradas ' + cambios + ' actividades'); } catch (eLog) {}
    }

    props.setProperty('MIGRACION_CONSOLIDADO_2026_V2_OK', 'true');
    return cambios > 0;
  } finally {
    lock.releaseLock();
  }
}
